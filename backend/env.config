# =====================================================
# TechStock Backend Environment Configuration File
# =====================================================


# =========================
# Email Configuration
# Gmail account used for sending system emails
# (e.g. verification, notifications)
# IMPORTANT: Use Gmail App Password, not your real password
# =========================
EMAIL_USER=
EMAIL_PASS=

# =========================
# Database Configuration (MySQL)
# =========================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=techstock
DB_PORT=3306

# =========================
# JWT Configuration
# Secret key used for authentication tokens
# Keep this value secure and never expose it publicly
# =========================
JWT_SECRET=
